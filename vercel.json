{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/models/:path*", "destination": "/assets/models/:path*" },
    { "source": "/onnxruntime-web/:path*", "destination": "/assets/onnxruntime-web/:path*" }
  ]
}
